{
  "name": "ojterm-server",
  "version": "1.0.0",
  "description": "OJTerm Backend API - Smart Web-Based OJT Matching Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "migrate:cli": "npx sequelize-cli db:migrate",
    "seed": "node src/seeders/runSeeds.js",
    "seed:cli": "npx sequelize-cli db:seed:all",
    "test:volume": "node src/scripts/testVolume.js",
    "test:scenarios": "node src/scripts/verifyScenarios.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
